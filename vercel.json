{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "buildCommand": "npm run migrate && npm run build",
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/accounting",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/work",
      "schedule": "0 5 * * *"
    }
  ]
}
