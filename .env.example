# Copy this file to .env.local and fill it in. Files ending in .local are never committed.

# The clinic's database. With Docker Compose (compose.yaml) on this computer:
DATABASE_URL=postgres://linden:linden@localhost:5432/linden
# The tests' own database, which they empty every time.
TEST_DATABASE_URL=postgres://linden:linden@localhost:5432/linden_test

# Where the app's mail goes. On this computer, Mailpit (compose.yaml); read it at http://localhost:8025.
MAIL_URL=smtp://localhost:1025
# In production, mail goes through Resend instead: its API key, with sending access only. Leave it empty
# here, or this computer's mail goes to real inboxes.
RESEND_API_KEY=

# Signing in (server/auth.ts). Where this app is, and a long random secret: `openssl rand -base64 32`.
BETTER_AUTH_URL=http://localhost:5173
# Every address the app's pages are at, for the links in its mail: Linden's and Birch's. On this computer,
# http://localhost:5173 and http://birch.localhost:5173 (browsers send *.localhost to this computer).
BETTER_AUTH_HOSTS=localhost:5173,linden.localhost:5173,birch.localhost:5173
BETTER_AUTH_SECRET=
# The app registration "Linden Physio staff" in the clinic's Microsoft Entra ID.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
