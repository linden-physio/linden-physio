# Copy this file to .env.local and fill it in. Files ending in .local are never committed.

# The clinic's database. With Docker Compose (compose.yaml) on this computer:
DATABASE_URL=postgres://linden:linden@localhost:5432/linden
# The tests' own database, which they empty every time.
TEST_DATABASE_URL=postgres://linden:linden@localhost:5432/linden_test

# Where the app's mail goes. On this computer, Mailpit (compose.yaml); read it at http://localhost:8025.
MAIL_URL=smtp://localhost:1025
# In production, mail goes through Resend instead: its API key, with sending access only. Leave it empty
# here, or this computer's mail goes to real inboxes.
RESEND_API_KEY=

# Signing in (server/auth.ts). Where this app is, and a long random secret: `openssl rand -base64 32`.
BETTER_AUTH_URL=http://localhost:5173
# Every address the app's pages are at, for the links in its mail: Linden's and Birch's. On this computer,
# http://localhost:5173 and http://birch.localhost:5173 (browsers send *.localhost to this computer).
BETTER_AUTH_HOSTS=localhost:5173,linden.localhost:5173,birch.localhost:5173
BETTER_AUTH_SECRET=
# The app registration "Linden Physio staff" in the clinic's Microsoft Entra ID.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Kassa (kassa/), the stand-in for a card payment provider like Stripe: `npm run kassa` starts it at
# http://localhost:4242, with its own database. The secret key is for our server only; the publishable
# key may be in the page. In production these would be Stripe's sk_test_… and pk_test_… keys.
KASSA_URL=http://localhost:4242
KASSA_SECRET_KEY=sk_test_kassa_local
KASSA_PUBLISHABLE_KEY=pk_test_kassa_local
KASSA_DATABASE_URL=postgres://linden:linden@localhost:5432/kassa
# Where Kassa sends its events, and the secret it signs them with (Stripe's whsec_…): both programs need
# the secret. Kassa reads KASSA_WEBHOOK_URL; on a real provider it's set in its dashboard.
KASSA_WEBHOOK_URL=http://localhost:5173/api/payments/webhook
KASSA_WEBHOOK_SECRET=whsec_kassa_local
# Vercel sends this with each scheduled call (vercel.json's crons). Any long random string; on this
# computer, call them yourself: curl -H "Authorization: Bearer $CRON_SECRET" localhost:5173/api/cron/reminders
CRON_SECRET=

# Ekonomihuset (ekonomihuset/), the stand-in for the accountant's system: `npm run ekonomihuset`. It
# takes the nightly file over SFTP (sftp://linden:linden@localhost:2222/inbox) or HTTPS
# (http://localhost:4300/files, with the token), and books it all or none.
EKONOMIHUSET_DATABASE_URL=postgres://linden:linden@localhost:5432/ekonomihuset
EKONOMIHUSET_TOKEN=eko_local
# Where our app sends the nightly file: either door.
ACCOUNTING_URL=sftp://linden:linden@localhost:2222/inbox
# For the HTTPS door instead: ACCOUNTING_URL=http://localhost:4300/files, and its token.
ACCOUNTING_TOKEN=eko_local
